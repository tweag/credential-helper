load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "lookupchain",
    srcs = ["lookupchain.go"],
    importpath = "github.com/tweag/credential-helper/authenticate/internal/lookupchain",
    visibility = ["//authenticate:__subpackages__"],
    deps = [
        "@com_github_zalando_go_keyring//:go-keyring",
        "@com_google_cloud_go_secretmanager//apiv1",
        "@com_google_cloud_go_secretmanager//apiv1/secretmanagerpb",
        "@org_golang_google_api//idtoken",
        "@org_golang_google_api//option",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_x_oauth2//:oauth2",
        "@org_golang_x_oauth2//google",
    ],
)

go_test(
    name = "lookupchain_test",
    srcs = ["gcpsecretmanager_test.go"],
    embed = [":lookupchain"],
    deps = [
        "@com_github_google_go_cmp//cmp",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
        "@org_golang_x_oauth2//:oauth2",
    ],
)

filegroup(
    name = "all_files",
    srcs = glob(["*"]),
    visibility = ["//:__subpackages__"],
)
